---
import RenewalLayout from '../layouts/RenewalLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
const categories = [...new Set(posts.map(post => post.data.category).filter((category): category is string => Boolean(category)))].sort();
---
<RenewalLayout title="ETC. | HIKIKO SURVIVAL" description="好きなこと、気になること。ヒキコの日々の記録をテーマから探す。">
  <p class="eyebrow">EXPLORE</p><h1>ETC.</h1><p class="intro">好きなこと、気になること。<br />日々の記録を、テーマから。</p>
  <nav aria-label="ブログのテーマ"><ul>{categories.map(category => <li><a href={`/blog/?category=${encodeURIComponent(category)}`}>{category}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
  <a class="back" href="/">← HOME</a>
</RenewalLayout>
<style>
  .eyebrow { font-size: 11px; letter-spacing: .2em; color: #786b47; }
  h1 { font-size: 44px; letter-spacing: .08em; }
  .intro { font-size: 14px; line-height: 2; margin: 24px 0 42px; }
  ul { padding: 0; margin: 0 0 40px; list-style: none; }
  li a { display: flex; justify-content: space-between; gap: 24px; color: #292824; padding: 24px 4px; text-decoration: none; font-size: 16px; border-bottom: 1px solid #d9d3c1; }
  li a:hover { color: #8a6812; background: #f5f1e5; }
  .back { color: #6c5b2b; font-size: 12px; }
</style>
