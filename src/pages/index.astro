---
import RenewalLayout from '../layouts/RenewalLayout.astro';
---
<RenewalLayout title="HIKIKO SURVIVAL" description="書くこと、描くこと、好きなものを探求すること。ヒキコの活動と作品を紹介するサイト。" home>
  <section class="home-hero" aria-labelledby="home-title">
    <img class="main-visual" src="/home-main-visual.webp" alt="" width="1920" height="1355" fetchpriority="high" />
    <div class="veil"></div>
    <div class="intro">
      <p class="eyebrow">HIKIKO'S PERSONAL WEBSITE</p>
      <h1 id="home-title">書くこと、<br />描くこと、<br /><span>好きなものを探求すること。</span></h1>
      <p class="description">文章やイラスト、ひきこもり生活の中で見つけた<br class="desktop-break" />日々の発見や試行錯誤。<br />このサイトでは、そんなヒキコの活動と作品を紹介しています。</p>
      <a class="profile-link" href="/about/">PROFILE <span aria-hidden="true">↗</span></a>
    </div>
    <nav class="entry-bars" aria-label="活動と作品">
      <a class="entry blog" href="/blog/"><span class="number" aria-hidden="true">01</span><span class="label">BLOG<small>日々の発見と試行錯誤</small></span><span class="arrow" aria-hidden="true">↗</span></a>
      <a class="entry illustration" href="/illustration/"><span class="number" aria-hidden="true">02</span><span class="label">ILLUSTRATION<small>描いたもの</small></span><span class="arrow" aria-hidden="true">↗</span></a>
      <a class="entry etc" href="/etc/"><span class="number" aria-hidden="true">03</span><span class="label">ETC.<small>そのほか、好きなこと</small></span><span class="arrow" aria-hidden="true">↗</span></a>
    </nav>
    <p class="credit">Illustration by Hikiko</p>
  </section>
</RenewalLayout>
<style>
  .home-hero { position: relative; isolation: isolate; min-height: max(740px, calc(100svh - 170px)); display: flex; align-items: flex-start; overflow: hidden; }
  .main-visual { position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%; object-fit: cover; object-position: 42% 40%; border-radius: 0; opacity: .32; }
  .veil { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(255,254,250,.87), rgba(255,254,250,.35) 58%, rgba(255,254,250,.08)); }
  .intro { width: min(650px, 58%); padding: clamp(64px, 8vw, 120px) 0 170px max(32px, calc((100vw - 1280px) / 2)); }
  .eyebrow { font-size: 11px; letter-spacing: .2em; margin: 0 0 30px; color: #635e58; }
  h1 { font-size: clamp(32px, 3.7vw, 56px); line-height: 1.65; font-weight: 500; letter-spacing: .09em; color: #292824; margin: 0 0 24px; }
  h1 span { font-size: .57em; white-space: nowrap; letter-spacing: .04em; }
  .description { font-size: 14px; line-height: 2.25; color: #494741; margin: 0 0 32px; }
  .profile-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 60px; padding: 13px 0; border-block: 1px solid #746b53; color: #292824; font-size: 12px; letter-spacing: .16em; text-decoration: none; }
  .profile-link:hover { color: #8a6812; }
  .entry-bars { position: absolute; right: 0; bottom: 85px; width: min(560px, 43%); display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
  .entry { box-sizing: border-box; display: flex; align-items: center; gap: 22px; min-height: 94px; padding: 18px 40px 18px 28px; text-decoration: none; color: #fffefa; transition: padding .2s ease, background .2s ease; }
  .entry:hover { padding-right: 54px; }
  .blog { width: 100%; background: #34352f; }
  .illustration { width: 89%; background: #68634f; }
  .etc { width: 76%; background: #e1d7ac; color: #33332b; }
  .number { font-size: 11px; opacity: .7; align-self: flex-start; padding-top: 5px; }
  .label { font-size: clamp(17px, 1.7vw, 25px); line-height: 1.3; letter-spacing: .09em; }
  .label small { display: block; font-size: 10px; letter-spacing: .09em; margin-top: 8px; }
  .arrow { margin-left: auto; font-size: 23px; }
  .credit { position: absolute; bottom: 18px; left: max(32px, calc((100vw - 1280px) / 2)); font-size: 10px; letter-spacing: .08em; color: #666158; }
  @media (max-width: 900px) {
    .home-hero { min-height: 0; display: block; }
    .intro { width: auto; padding: 64px 28px 48px; }
    h1 { font-size: clamp(32px, 5.8vw, 48px); }
    .entry-bars { position: relative; width: min(590px, 88%); margin: 0 0 76px auto; bottom: auto; }
    .main-visual { object-position: 38% center; }
    .veil { background: linear-gradient(90deg, rgba(255,254,250,.9), rgba(255,254,250,.38)); }
    .label { font-size: 23px; }
    .credit { left: 28px; }
  }
  @media (max-width: 480px) {
    .intro { padding: 44px 22px 38px; }
    .eyebrow { font-size: 9px; margin-bottom: 23px; }
    h1 { font-size: 32px; letter-spacing: .04em; }
    h1 span { font-size: .51em; }
    .description { font-size: 12px; line-height: 2.1; }
    .desktop-break { display: none; }
    .entry-bars { width: 94%; gap: 12px; }
    .entry { min-height: 85px; padding: 16px 22px; gap: 14px; }
    .entry:hover { padding-right: 28px; }
    .label { font-size: 19px; }
    .label small { font-size: 9px; }
    .credit { left: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .entry { transition: none; } }
</style>
